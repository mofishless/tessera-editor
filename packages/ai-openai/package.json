{
  "name": "@tessera-editor/ai-openai",
  "version": "0.1.0",
  "description": "Tessera AIRuntime adapter for OpenAI-compatible APIs (SSE)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
